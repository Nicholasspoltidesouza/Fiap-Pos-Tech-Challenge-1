POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=oficina_mec_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_SQL_INIT_MODE=always

# JWT (generate a strong random value for real environments)
JWT_SECRET=oficina-local-hs512-secret-not-for-production-000000000000000001
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=oficina-auth
NOTIFICACAO_HTTP_URL=http://notify-lambda:8080/notify
ZIPKIN_ENDPOINT=http://jaeger:9411/api/v2/spans

# Email (MailHog for local development)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICACAO_EMAIL_REMETENTE=oficina@oficina.com
NOTIFICACAO_EMAIL_DESTINATARIO=notificacoes@oficina.com
